{
  "name": "live-cms-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev -- --host",
    "build": "npm --prefix client run build",
    "docker:build": "docker build -t codexexample:latest .",
    "lint": "npm --prefix client run lint",
    "start": "node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "mongoose": "^8.19.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "vitest": "^4.0.8"
  }
}
